{
  "name": "<%= projectName %>",
  "version": "0.1.0",
  "private": true,
  "description": "<%= description %>",
  "author": "<%= author %>",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "clean": "turbo clean && rimraf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.18.2"
  }
}
