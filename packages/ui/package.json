    "react": "^18.0.0"
  },
  "devDependencies": {
    "<%= scope %>/tsconfig": "workspace:*",
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.2"
  }
}
